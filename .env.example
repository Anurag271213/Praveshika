# =====================================================================
# Global Environment Variables Template
# Copy to .env for local overrides (never commit .env to source control)
# =====================================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/login_feature_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password_here

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Security (Must be at least 256 bits / 32 characters in length)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_alphanumeric_secret_key
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=login-feature-backend

# Default Administrator Seed Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
